gametitle=Kingdom Hearts Final Mix (NTSC-J) [SLPS-25198] BD3FB233 (English patched)

[Swap X and O (Western controls)]
author=Claude (ported from PCSX2 patch DB SLPS-25198_BD3FB870)
description=Swaps Cross and Circle (digital + pressure) so X confirms and O cancels. Hook points verified identical in this build.
// entry hook: save rdata ptr in t9, run original first insn, resume
patch=1,EE,000fd050,word,00a0c821 // move t9,a1
patch=1,EE,000fd054,word,0809a33d // j    0x268cf4
patch=1,EE,000fd058,word,24020330 // addiu v0,zero,0x330 (original insn, delay slot)
patch=1,EE,000fd05c,word,87240000 // lh   a0,0(t9)      buttons halfword
patch=1,EE,000fd060,word,30859fff // andi a1,a0,0x9fff  clear circle/cross
patch=1,EE,000fd064,word,9326000c // lbu  a2,0xc(t9)    cross pressure
patch=1,EE,000fd068,word,9327000b // lbu  a3,0xb(t9)    circle pressure
patch=1,EE,000fd06c,word,30814000 // andi at,a0,0x4000
patch=1,EE,000fd070,word,34a32000 // ori  v1,a1,0x2000
patch=1,EE,000fd074,word,0061280b // movn a1,v1,at      circle <- cross
patch=1,EE,000fd078,word,a326000b // sb   a2,0xb(t9)
patch=1,EE,000fd07c,word,30812000 // andi at,a0,0x2000
patch=1,EE,000fd080,word,34a34000 // ori  v1,a1,0x4000
patch=1,EE,000fd084,word,0061280b // movn a1,v1,at      cross <- circle
patch=1,EE,000fd088,word,a327000c // sb   a3,0xc(t9)
patch=1,EE,000fd08c,word,03e00008 // jr   ra
patch=1,EE,000fd090,word,a7250000 // sh   a1,0(t9)      (delay slot)
patch=1,EE,00268cec,word,0803f414 // j 0x0fd050  (was 24020330)
patch=1,EE,00268db4,word,0803f417 // j 0x0fd05c  (was jr ra / 03e00008)

[Right Stick Camera]
author=Claude
description=Push right = camera swings right. Right stick left/right drives KH1's L2/R2 camera rotation. Active only in the field (KH1 main mode 3), so the Gummi Garage, world map and Gummi flight never see stick-made L2/R2 presses. Analog mode only (no effect in digital mode). Works with or without the X/O swap. Enable only ONE camera patch.
patch=1,EE,000fd0a0,word,0c047cdc // jal  0x11f370        (original call: analog -> direction bits)
patch=1,EE,000fd0a4,word,03a0282d // move a1,sp           (delay slot, original)
patch=1,EE,000fd0a8,word,3c01002c // lui  at,0x2c
patch=1,EE,000fd0ac,word,8c21bde0 // lw   at,0x2bbde0     KH1 main-loop mode (3 = field, 5 = Gummi: world map/garage/flight)
patch=1,EE,000fd0b0,word,24040003 // addiu a0,zero,3
patch=1,EE,000fd0b4,word,14240008 // bne  at,a0,done      not in the field: leave buttons alone
patch=1,EE,000fd0b8,word,93a40002 // lbu  a0,2(sp)        (delay slot) right stick X (0x00 left .. 0xFF right)
patch=1,EE,000fd0bc,word,2c850040 // sltiu a1,a0,0x40     deflected left?
patch=1,EE,000fd0c0,word,10a00002 // beqz a1,+2
patch=1,EE,000fd0c4,word,2c8500c1 // sltiu a1,a0,0xc1     (delay slot) a1==0: deflected right
patch=1,EE,000fd0c8,word,34420100 // ori  v0,v0,0x100      stick left  -> L2
patch=1,EE,000fd0cc,word,14a00002 // bnez a1,+2
patch=1,EE,000fd0d0,word,00000000 // nop
patch=1,EE,000fd0d4,word,34420200 // ori  v0,v0,0x200      stick right -> R2
patch=1,EE,000fd0d8,word,08047dd5 // done: j 0x11f754     back to caller (or s2,s2,v0)
patch=1,EE,000fd0dc,word,00000000 // nop
patch=1,EE,0011f74c,word,0200202d // move a0,s0           (delay slot of hook)
patch=1,EE,0011f748,word,0803f428 // j 0x0fd0a0          (was: move a0,s0 ; jal 0x11f370 - analog-mode branch only)

[Right Stick Camera (Inverted)]
author=Claude
description=Inverted: push right = camera swings left. Right stick left/right drives KH1's L2/R2 camera rotation. Active only in the field (KH1 main mode 3), so the Gummi Garage, world map and Gummi flight never see stick-made L2/R2 presses. Analog mode only (no effect in digital mode). Works with or without the X/O swap. Enable only ONE camera patch.
